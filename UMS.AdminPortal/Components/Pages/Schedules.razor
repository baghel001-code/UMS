@page "/schedules"
@inherits TenantPage
@inject IDialogService Dialogs
@using DomainLayer.Services

<PageTitle>Office Hours · VMM UMS</PageTitle>

<PageHeader Title="Office Hours & Holidays"
            Subtitle="Named time windows used by ABAC policies (e.g. “Payroll only during General Office Hours”). Holidays can close a schedule for all or specific regions.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenAsync(null)">New schedule</MudButton>
    </Actions>
</PageHeader>

<MudGrid Spacing="3" Class="mb-4">
    @foreach (var s in _schedules)
    {
        var schedule = s.ToSchedule();
        var users = UsedBy(s);
        <MudItem xs="12" lg="6">
            <MudPaper Class="ums-card" Elevation="0">
                <div class="ums-card-head">
                    <div>
                        <MudText Typo="Typo.h6">@s.Name</MudText>
                        <MudText Typo="Typo.caption" Class="muted"><span class="mono">@s.Code</span> · @s.Timezone · @(s.ExcludeHolidays ? "closed on holidays" : "open on holidays")</MudText>
                    </div>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => OpenAsync(s)">Edit</MudButton>
                </div>
                <div class="ums-card-body">
                    <WeekGrid Cell="(d, h) => Cell(schedule, d, h)" AriaLabel="@s.Name" />
                    <div class="mt-3" style="font-size:12.5px">
                        @foreach (var w in s.Windows)
                        {
                            <div>
                                @string.Join(", ", w.Days) · @w.Start–@w.End
                                @if (string.CompareOrdinal(w.End, w.Start) < 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">overnight</MudChip>
                                }
                            </div>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Class="muted">Used by: @(users.Count == 0 ? "no policy" : string.Join("; ", users))</MudText>
                </div>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudPaper Class="ums-card" Elevation="0">
    <div class="ums-card-head"><MudText Typo="Typo.h6">Holiday calendar</MudText></div>
    <div class="ums-card-body">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
            <MudDatePicker @bind-Date="_holDate" Label="Date" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" Style="max-width:170px" />
            <MudTextField @bind-Value="_holName" Label="Holiday name" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:240px" />
            @foreach (var r in Users.Regions)
            {
                <MudCheckBox T="bool" Value="_holRegions.Contains(r)" ValueChanged="on => { if (on) _holRegions.Add(r); else _holRegions.Remove(r); }" Label="@r" Size="Size.Small" Color="Color.Primary" />
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddHolidayAsync">Add holiday</MudButton>
        </MudStack>
        <MudTable Items="_holidays.OrderBy(h => h.Date)" Dense="true" Elevation="0" Class="ums-table" Hover="true">
            <HeaderContent><MudTh>Date</MudTh><MudTh>Holiday</MudTh><MudTh>Regions</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@Fmt.Date(context.Date)</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>
                    @if (context.Regions.Count == 0)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">All India</MudChip>
                    }
                    @foreach (var r in context.Regions)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@r</MudChip>
                    }
                </MudTd>
                <MudTd Style="text-align:right"><MudButton Size="Size.Small" Color="Color.Error" OnClick="() => RemoveHolidayAsync(context)">Remove</MudButton></MudTd>
            </RowTemplate>
        </MudTable>
    </div>
</MudPaper>

@code {
    // a Monday, used to draw the regular weekly pattern
    private static readonly DateTime BaseMonday = new(2026, 10, 19);

    private List<ScheduleDto> _schedules = new();
    private List<HolidayDto> _holidays = new();
    private List<PolicyDto> _policies = new();
    private DateTime? _holDate;
    private string _holName = "";
    private HashSet<string> _holRegions = new();

    public static (bool, string) Cell(DomainLayer.Entities.Schedule schedule, Weekday day, int hour)
    {
        var at = BaseMonday.AddDays((int)day - 1).AddHours(hour).AddMinutes(30);
        var on = ScheduleEvaluator.IsInSchedule(schedule, at, Array.Empty<DomainLayer.Entities.Holiday>(), null);
        return (on, $"{day} {hour:00}:30 {(on ? "open" : "closed")}");
    }

    private List<string> UsedBy(ScheduleDto s) => _policies
        .Where(p => p.Conditions.Any(c => c.Operator is ConditionOperator.InSchedule or ConditionOperator.NotInSchedule && (c.Value == s.Id.ToString() || c.Value == s.Code)))
        .Select(p => p.Name).ToList();

    protected override async Task LoadAsync()
    {
        var schedules = Api.SchedulesAsync();
        var holidays = Api.HolidaysAsync();
        var policies = Api.PoliciesAsync();
        _schedules = await schedules;
        _holidays = await holidays;
        _policies = await policies;
    }

    private async Task OpenAsync(ScheduleDto? s)
    {
        var parameters = new DialogParameters<ScheduleDialog>
        {
            { x => x.Model, s is null ? new ScheduleEdit { TenantId = TenantId } : ScheduleEdit.From(s) },
            { x => x.IsNew, s is null },
            { x => x.InUse, s is null ? 0 : UsedBy(s).Count },
        };
        var dialog = await Dialogs.ShowAsync<ScheduleDialog>(s is null ? "New schedule" : $"Schedule: {s.Name}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) await ReloadAsync();
    }

    private async Task AddHolidayAsync()
    {
        if (_holDate is null || string.IsNullOrWhiteSpace(_holName)) { Ui.Error("Date and name are required"); return; }
        var h = new HolidayDto(Guid.NewGuid(), TenantId, DateOnly.FromDateTime(_holDate.Value), _holName.Trim(), _holRegions.ToList());
        if (await Ui.Run(() => Api.AddHolidayAsync(h)) is null) return;
        Ui.Ok($"Added {h.Name}");
        (_holDate, _holName, _holRegions) = (null, "", new HashSet<string>());
        await ReloadAsync();
    }

    private async Task RemoveHolidayAsync(HolidayDto h)
    {
        if (await Ui.Run(() => Api.DeleteHolidayAsync(h.Id))) await ReloadAsync();
    }
}
