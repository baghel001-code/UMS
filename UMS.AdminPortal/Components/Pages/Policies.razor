@page "/policies"
@inherits TenantPage
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>Policies · VMM UMS</PageTitle>

<PageHeader Title="ABAC Policies"
            Subtitle="Attribute-based rules evaluated after RBAC on every request: who (user.*), what (resource.*), and when / where / how (env.*).">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenAsync(null)">New policy</MudButton>
    </Actions>
</PageHeader>

<MudPaper Class="ums-card" Elevation="0">
    <MudToolBar Gutters="true" Class="gap-3 py-2" Style="height:auto;flex-wrap:wrap">
        <MudTextField @bind-Value="_search" Placeholder="Search policies…" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:240px" />
        <MudSelect T="PolicyEffect?" @bind-Value="_effect" Label="Effect" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:160px">
            @foreach (var e in Enum.GetValues<PolicyEffect>())
            {
                <MudSelectItem T="PolicyEffect?" Value="e">@e</MudSelectItem>
            }
        </MudSelect>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="muted">Evaluated in priority order · deny-overrides</MudText>
    </MudToolBar>
    <MudTable Items="Rows" Hover="true" Class="ums-table" Elevation="0" Loading="Loading" RowsPerPage="25"
              OnRowClick="(TableRowClickEventArgs<PolicyDto> e) => OpenAsync(e.Item)">
        <HeaderContent>
            <MudTh>Prio</MudTh><MudTh>Policy</MudTh><MudTh>Effect</MudTh><MudTh>Applies to</MudTh><MudTh>Rule</MudTh><MudTh>Active</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Priority</MudTd>
            <MudTd Style="max-width:300px"><b>@context.Name</b><div class="muted" style="font-size:12px">@context.Description</div></MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="EffectColor(context.Effect)">@context.Effect</MudChip></MudTd>
            <MudTd>
                <span class="mono">@Target(context.Target)</span>
                @if (context.Target.Roles.Count > 0)
                {
                    <div class="muted" style="font-size:12px">roles: @string.Join(", ", context.Target.Roles)</div>
                }
            </MudTd>
            <MudTd Style="max-width:380px"><span class="mono">@context.RuleExpression</span></MudTd>
            <MudTd @onclick:stopPropagation="true">
                <MudSwitch T="bool" Value="context.IsActive" ValueChanged="on => ToggleAsync(context, on)" Color="Color.Success" />
            </MudTd>
        </RowTemplate>
        <PagerContent><MudTablePager /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<PolicyDto> _policies = new();
    private List<ApplicationDto> _apps = new();
    private List<RoleDto> _roles = new();
    private List<ScheduleDto> _schedules = new();
    private string _search = "";
    private PolicyEffect? _effect;
    private bool _openedNew;

    public static Color EffectColor(PolicyEffect e) => e switch { PolicyEffect.Deny => Color.Error, PolicyEffect.Grant => Color.Success, _ => Color.Info };
    private static string Target(PolicyTargetDto t) => $"{t.App}.{t.Module}.{t.Resource}.{string.Join('|', t.Actions)}";

    private IEnumerable<PolicyDto> Rows => _policies
        .Where(p => (_effect is null || p.Effect == _effect) && $"{p.Name} {p.Description} {Target(p.Target)}".Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderBy(p => p.Priority);

    protected override async Task LoadAsync()
    {
        var policies = Api.PoliciesAsync();
        var apps = Api.ApplicationsAsync();
        var roles = Api.RolesAsync();
        var schedules = Api.SchedulesAsync();
        _policies = await policies;
        _apps = await apps;
        _roles = await roles;
        _schedules = await schedules;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_openedNew && !Loading && Nav.Uri.Contains("new=1"))
        {
            _openedNew = true;
            await OpenAsync(null);
        }
    }

    private async Task ToggleAsync(PolicyDto p, bool on)
    {
        if (p.IsActive == on) return;
        if (await Ui.Run(() => Api.SavePolicyAsync(p with { IsActive = on })) is not null)
        {
            Ui.Ok($"{(on ? "Enabled" : "Disabled")} '{p.Name}'");
            await ReloadAsync();
        }
    }

    private async Task OpenAsync(PolicyDto? policy)
    {
        var model = policy is null ? new PolicyEdit { TenantId = TenantId } : PolicyEdit.From(policy);
        var parameters = new DialogParameters<PolicyDialog>
        {
            { x => x.Model, model },
            { x => x.IsNew, policy is null },
            { x => x.Applications, _apps },
            { x => x.Roles, _roles },
            { x => x.Schedules, _schedules },
        };
        var dialog = await Dialogs.ShowAsync<PolicyDialog>(policy is null ? "New ABAC policy" : $"Policy: {policy.Name}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) await ReloadAsync();
    }
}
