@inject UmsApiClient Api
@inject Ui Ui

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="Model.Code" Label="Code" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="Model.Name" Label="Name" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="Model.Timezone" Label="Time zone" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Asia/Kolkata")">Asia/Kolkata (IST)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Dubai")">Asia/Dubai</MudSelectItem>
                    <MudSelectItem Value="@("UTC")">UTC</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" Class="d-flex align-center"><MudSwitch @bind-Value="Model.ExcludeHolidays" Color="Color.Primary" Label="Closed on holidays" /></MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="mt-4 mb-2">Time windows</MudText>
        @foreach (var w in Model.Windows)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-2">
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="0">
                    @foreach (var d in Enum.GetValues<Weekday>())
                    {
                        <MudCheckBox T="bool" Value="w.Days.Contains(d)" ValueChanged="on => { if (on) w.Days.Add(d); else w.Days.Remove(d); }" Label="@d.ToString()" Size="Size.Small" Color="Color.Primary" />
                    }
                </MudStack>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTimePicker @bind-Time="w.Start" Label="From" Variant="Variant.Outlined" Margin="Margin.Dense" AmPm="false" />
                    <MudTimePicker @bind-Time="w.End" Label="To" Variant="Variant.Outlined" Margin="Margin.Dense" AmPm="false" />
                    @if (w.End < w.Start)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">overnight — ends next day</MudChip>
                    }
                    <MudSpacer />
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => Model.Windows.Remove(w)">Remove</MudButton>
                </MudStack>
            </MudPaper>
        }
        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="() => Model.Windows.Add(new WindowEdit())">Add window</MudButton>
        <div class="mt-4"><WeekGrid Cell="Preview" AriaLabel="Schedule preview" /></div>
    </DialogContent>
    <DialogActions>
        @if (!IsNew)
        {
            <MudTooltip Text="@(InUse > 0 ? "Used by policies" : "")">
                <MudButton Color="Color.Error" Disabled="@(InUse > 0)" OnClick="DeleteAsync">Delete</MudButton>
            </MudTooltip>
        }
        <MudSpacer />
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ScheduleEdit Model { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public int InUse { get; set; }
    private bool _busy;

    private (bool, string) Preview(Weekday day, int hour)
    {
        try
        {
            return Schedules.Cell(Model.ToDto().ToSchedule(), day, hour);
        }
        catch (DomainLayer.Exceptions.DomainException)
        {
            return (false, "");
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        var saved = await Ui.Run(() => Api.SaveScheduleAsync(Model.ToDto()));
        _busy = false;
        if (saved is null) return;
        Ui.Ok("Schedule saved");
        MudDialog.Close(DialogResult.Ok(saved));
    }

    private async Task DeleteAsync()
    {
        if (await Ui.Run(() => Api.DeleteScheduleAsync(Model.Id))) MudDialog.Close(DialogResult.Ok(true));
    }
}
