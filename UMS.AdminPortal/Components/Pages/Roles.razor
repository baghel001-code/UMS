@page "/roles"
@inherits TenantPage
@inject IDialogService Dialogs
@inject NavigationManager Nav
@using DomainLayer.ValueObjects

<PageTitle>Roles · VMM UMS</PageTitle>

<PageHeader Title="Roles & Permissions"
            Subtitle="A role is a named bundle of permissions (APP.MODULE.RESOURCE.ACTION). Assign roles to users, optionally scoped and time-bound.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenAsync(null)">New role</MudButton>
    </Actions>
</PageHeader>

<MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pt-4" Rounded="true">
    <MudTabPanel Text="Roles">
        <MudPaper Class="ums-card" Elevation="0">
            <MudToolBar Gutters="true" Class="gap-3 py-2" Style="height:auto;flex-wrap:wrap">
                <MudTextField @bind-Value="_search" Placeholder="Search roles…" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:240px" />
                <MudSelect T="string" @bind-Value="_appFilter" Label="Application" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:260px">
                    <MudSelectItem T="string" Value="CrossApp">Cross-application roles</MudSelectItem>
                    @foreach (var a in _apps)
                    {
                        <MudSelectItem T="string" Value="a.Id.ToString()">@a.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudToolBar>
            <MudTable Items="Rows" Hover="true" Class="ums-table" Elevation="0" Loading="Loading" RowsPerPage="25"
                      OnRowClick="(TableRowClickEventArgs<RoleDto> e) => OpenAsync(e.Item)">
                <HeaderContent>
                    <MudTh>Role</MudTh><MudTh>Application</MudTh><MudTh>Description</MudTh><MudTh>Permissions</MudTh><MudTh>Members</MudTh><MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <b>@context.Name</b>
                        @if (context.IsSystem)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">system</MudChip>
                        }
                        <div class="mono muted">@context.Code</div>
                    </MudTd>
                    <MudTd>@AppLabel(context.AppId)</MudTd>
                    <MudTd Class="muted">@context.Description</MudTd>
                    <MudTd>@context.Permissions.Count keys</MudTd>
                    <MudTd>@Members(context.Id)</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.IsActive ? Color.Success : Color.Warning)">@(context.IsActive ? "Active" : "Inactive")</MudChip></MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Role × Application matrix">
        <MudPaper Class="ums-card" Elevation="0">
            <div class="ums-card-head">
                <MudText Typo="Typo.caption" Class="muted">Full = every permission of the app · Partial = some · blank = no access. Click a role to edit.</MudText>
            </div>
            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="ums-matrix" Style="overflow-x:auto">
                <thead>
                    <tr>
                        <th>Role</th>
                        @foreach (var a in _apps)
                        {
                            <th title="@a.Name">@a.Code</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _roles)
                    {
                        <tr style="cursor:pointer" @onclick="() => OpenAsync(r)">
                            <td style="white-space:nowrap">@r.Name</td>
                            @foreach (var a in _apps)
                            {
                                var c = Coverage(r, a);
                                <td>
                                    @if (c == "Full")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Full</MudChip>
                                    }
                                    else if (c == "Partial")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Partial</MudChip>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private const string CrossApp = "cross";
    private List<RoleDto> _roles = new();
    private List<ApplicationDto> _apps = new();
    private List<UserAccountDto> _users = new();
    private string _search = "";
    private string? _appFilter;
    private bool _openedNew;

    private IEnumerable<RoleDto> Rows => _roles.Where(r =>
        $"{r.Name} {r.Code} {r.Description}".Contains(_search, StringComparison.OrdinalIgnoreCase)
        && (_appFilter is null || (_appFilter == CrossApp ? r.AppId is null : r.AppId?.ToString() == _appFilter)));

    private string AppLabel(Guid? appId) => appId is null ? "Cross-application" : _apps.FirstOrDefault(a => a.Id == appId)?.Name ?? "—";
    private int Members(Guid roleId) => _users.Count(u => u.Roles.Any(a => a.RoleId == roleId));

    public static string Coverage(RoleDto role, ApplicationDto app)
    {
        var keys = app.Modules.SelectMany(m => m.Resources.SelectMany(r => r.Actions.Select(a => PermissionKey.Of(app.Code, m.Code, r.Code, a.ToString())))).ToList();
        var granted = keys.Count(k => role.Permissions.Any(p => PermissionKey.Matches(p, k)));
        return granted == 0 ? "None" : granted == keys.Count ? "Full" : "Partial";
    }

    protected override async Task LoadAsync()
    {
        var roles = Api.RolesAsync();
        var apps = Api.ApplicationsAsync();
        var users = Api.UsersAsync();
        _roles = await roles;
        _apps = await apps;
        _users = await users;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_openedNew && !Loading && Nav.Uri.Contains("new=1"))
        {
            _openedNew = true;
            await OpenAsync(null);
        }
    }

    private async Task OpenAsync(RoleDto? role)
    {
        var model = role is null ? new RoleEdit { TenantId = TenantId } : RoleEdit.From(role);
        var parameters = new DialogParameters<RoleDialog>
        {
            { x => x.Model, model },
            { x => x.IsNew, role is null },
            { x => x.Applications, _apps },
            { x => x.Members, role is null ? new() : _users.Where(u => u.Roles.Any(a => a.RoleId == role.Id)).ToList() },
        };
        var dialog = await Dialogs.ShowAsync<RoleDialog>(role is null ? "New role" : $"Role: {role.Name}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) await ReloadAsync();
    }
}
