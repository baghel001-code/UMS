@page "/users"
@inherits TenantPage
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Users · VMM UMS</PageTitle>

<PageHeader Title="Users" Subtitle="@Subtitle">
    <Actions>
        <MudFileUpload T="IBrowserFile" Accept=".csv" FilesChanged="ImportAsync">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile">Bulk import CSV</MudButton>
            </ActivatorContent>
        </MudFileUpload>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAsync">Export</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="() => OpenAsync(null)">New user</MudButton>
    </Actions>
</PageHeader>

<MudPaper Class="ums-card" Elevation="0">
    <MudToolBar Gutters="true" Class="gap-2 py-2" Style="height:auto;flex-wrap:wrap">
        <MudTextField @bind-Value="_search" Placeholder="Search name, email, emp code, store…" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" DebounceInterval="250" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:260px" />
        <MudSelect T="string" @bind-Value="_dept" Label="Department" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:190px">
            @foreach (var d in _users.Select(u => u.Department).Distinct().Order())
            {
                <MudSelectItem T="string" Value="d">@d</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" @bind-Value="_roleId" Label="Role" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:200px">
            @foreach (var r in _roles)
            {
                <MudSelectItem T="Guid?" Value="r.Id">@r.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" @bind-Value="_region" Label="Region" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:140px">
            @foreach (var r in Regions)
            {
                <MudSelectItem T="string" Value="r">@r</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="EmploymentType?" @bind-Value="_emp" Label="Employment" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:160px">
            @foreach (var e in Enum.GetValues<EmploymentType>())
            {
                <MudSelectItem T="EmploymentType?" Value="e">@e</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="UserStatus?" @bind-Value="_status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:140px">
            @foreach (var s in Enum.GetValues<UserStatus>())
            {
                <MudSelectItem T="UserStatus?" Value="s">@s</MudSelectItem>
            }
        </MudSelect>
    </MudToolBar>

    @if (_selected.Count > 0)
    {
        <MudToolBar Dense="true" Class="gap-2" Style="background:var(--blue-100)">
            <MudText><b>@_selected.Count selected</b></MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="BulkAssignAsync">Assign role…</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" OnClick="() => BulkStatusAsync(UserStatus.Active)">Activate</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="() => BulkStatusAsync(UserStatus.Inactive)">Deactivate</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => BulkStatusAsync(UserStatus.Locked)">Lock</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _selected.Clear()">Clear</MudButton>
        </MudToolBar>
    }

    <MudTable Items="Rows" Hover="true" Class="ums-table" Elevation="0" Loading="Loading" MultiSelection="true" @bind-SelectedItems="_selected"
              OnRowClick="(TableRowClickEventArgs<UserAccountDto> e) => OpenAsync(e.Item)" RowsPerPage="20" Dense="true">
        <HeaderContent>
            <MudTh>User</MudTh>
            <MudTh>Department / Designation</MudTh>
            <MudTh>Location</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Roles</MudTh>
            <MudTh>MFA</MudTh>
            <MudTh>Last login</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><b>@context.FullName</b><div class="muted" style="font-size:12px">@context.EmpCode · @context.Email</div></MudTd>
            <MudTd>@context.Department<div class="muted" style="font-size:12px">@context.Designation</div></MudTd>
            <MudTd>@context.Location<div class="muted" style="font-size:12px">@context.Region</div></MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.EmploymentType == EmploymentType.Permanent ? Color.Default : Color.Warning)">@context.EmploymentType</MudChip>
            </MudTd>
            <MudTd>
                @foreach (var a in context.Roles.Where(a => RoleCode(a.RoleId) != "EMPLOYEE"))
                {
                    var active = IsActive(a);
                    var style = active ? null : ExpiredStyle;
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="@(active ? Variant.Outlined : Variant.Text)" Style="@style">@RoleCode(a.RoleId)</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.MfaEnabled ? Color.Success : Color.Warning)">@(context.MfaEnabled ? "On" : "Off")</MudChip>
            </MudTd>
            <MudTd Style="white-space:nowrap" Class="muted">@Fmt.DateTime(context.LastLogin)</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Fmt.StatusColor(context.Status.ToString())">@context.Status</MudChip></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-6 muted">No users match the filters.</MudText></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="new[] { 20, 50, 100 }" /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private const string ExpiredStyle = "text-decoration:line-through;opacity:.6";
    public static readonly string[] Regions = { "North", "East", "West", "South", "Central" };

    private List<UserAccountDto> _users = new();
    private List<RoleDto> _roles = new();
    private HashSet<UserAccountDto> _selected = new();
    private string _search = "";
    private string? _dept;
    private Guid? _roleId;
    private string? _region;
    private EmploymentType? _emp;
    private UserStatus? _status;
    private bool _openedNew;

    private string Subtitle => $"{Fmt.Number(_users.Count)} identities. Click a user to manage roles, attributes and effective access.";

    private IEnumerable<UserAccountDto> Rows => _users.Where(u =>
        $"{u.FullName} {u.Email} {u.EmpCode} {u.Location} {u.Designation}".Contains(_search, StringComparison.OrdinalIgnoreCase)
        && (_dept is null || u.Department == _dept)
        && (_region is null || u.Region == _region)
        && (_emp is null || u.EmploymentType == _emp)
        && (_status is null || u.Status == _status)
        && (_roleId is null || u.Roles.Any(r => r.RoleId == _roleId)));

    private string RoleCode(Guid id) => _roles.FirstOrDefault(r => r.Id == id)?.Code ?? "?";
    private static bool IsActive(RoleAssignmentDto a) => AssignmentEdit.From(a).IsActiveOn(DateOnly.FromDateTime(DateTime.Today));

    protected override async Task LoadAsync()
    {
        var users = Api.UsersAsync();
        var roles = Api.RolesAsync();
        _users = await users;
        _roles = await roles;
        _selected.Clear();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // dashboard "Add user" links here with ?new=1
        if (!_openedNew && !Loading && Nav.Uri.Contains("new=1"))
        {
            _openedNew = true;
            await OpenAsync(null);
        }
    }

    private async Task OpenAsync(UserAccountDto? user)
    {
        var model = user is null ? new UserEdit { TenantId = TenantId, EmpCode = $"VMM{20000 + _users.Count}" } : UserEdit.From(user);
        if (user is null && _roles.FirstOrDefault(r => r.Code == "EMPLOYEE") is { } employee) model.Roles.Add(new AssignmentEdit { RoleId = employee.Id });
        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.Model, model },
            { x => x.IsNew, user is null },
            { x => x.Roles, _roles },
            { x => x.Departments, _users.Select(u => u.Department).Distinct().Order().ToList() },
        };
        var dialog = await Dialogs.ShowAsync<UserDialog>(user is null ? "New user" : $"{user.FullName} · {user.EmpCode}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) await ReloadAsync();
    }

    private async Task BulkStatusAsync(UserStatus status)
    {
        var ids = _selected.Select(u => u.Id).ToList();
        if (await Ui.Run(() => Api.BulkUsersAsync(ids, status, null)) is > 0)
        {
            Ui.Ok($"{ids.Count} user(s) set to {status}");
            await ReloadAsync();
        }
    }

    private async Task BulkAssignAsync()
    {
        var dialog = await Dialogs.ShowAsync<AssignRoleDialog>("Assign role", new DialogParameters<AssignRoleDialog> { { x => x.Roles, _roles } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: AssignmentEdit assignment }) return;
        var ids = _selected.Select(u => u.Id).ToList();
        if (await Ui.Run(() => Api.BulkUsersAsync(ids, null, assignment.ToDto())) is > 0)
        {
            Ui.Ok($"Assigned {RoleCode(assignment.RoleId)} to {ids.Count} user(s)");
            await ReloadAsync();
        }
    }

    private async Task ExportAsync()
    {
        static string Esc(object? v) => "\"" + (v?.ToString() ?? "").Replace("\"", "\"\"") + "\"";
        var lines = new List<string> { "empCode,fullName,email,department,designation,location,region,employmentType,status,mfa,roles" };
        lines.AddRange(Rows.Select(u => string.Join(",", new object?[] { u.EmpCode, u.FullName, u.Email, u.Department, u.Designation, u.Location, u.Region,
            u.EmploymentType, u.Status, u.MfaEnabled, string.Join(" ", u.Roles.Select(r => RoleCode(r.RoleId))) }.Select(Esc))));
        await JS.InvokeVoidAsync("ums.download", "users.csv", "text/csv", string.Join("\n", lines));
    }

    /// <summary>CSV columns: empCode,fullName,email,department,designation,location,region[,employmentType]. New users get the EMPLOYEE role.</summary>
    private async Task ImportAsync(IBrowserFile? file)
    {
        if (file is null) return;
        using var reader = new StreamReader(file.OpenReadStream(5 * 1024 * 1024));
        var text = await reader.ReadToEndAsync();
        var lines = text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length < 2) { Ui.Error("The CSV has no data rows."); return; }
        string[] Split(string line) => line.Split(',').Select(v => v.Trim().Trim('"')).ToArray();
        var cols = Split(lines[0]);
        var need = new[] { "empCode", "fullName", "email", "department", "designation", "location", "region" };
        var missing = need.Where(c => !cols.Contains(c)).ToList();
        if (missing.Count > 0) { Ui.Error($"CSV missing columns: {string.Join(", ", missing)}"); return; }

        var employee = _roles.FirstOrDefault(r => r.Code == "EMPLOYEE");
        var users = lines.Skip(1).Select(line =>
        {
            var v = Split(line);
            string Col(string name) => Array.IndexOf(cols, name) is var i and >= 0 && i < v.Length ? v[i] : "";
            var empType = Enum.TryParse<EmploymentType>(Col("employmentType"), true, out var e) ? e : EmploymentType.Permanent;
            return new UserEdit
            {
                TenantId = TenantId, EmpCode = Col("empCode"), FullName = Col("fullName"), Email = Col("email"), Department = Col("department"),
                Designation = Col("designation"), Location = Col("location"), Region = Col("region"), EmploymentType = empType,
                Roles = employee is null ? new() : new() { new AssignmentEdit { RoleId = employee.Id } },
            }.ToDto();
        }).Where(u => u.EmpCode != "").ToList();

        var result = await Ui.Run(() => Api.ImportUsersAsync(users));
        if (result is null) return;
        Ui.Ok($"Imported {result.Created} user(s) from {file.Name}; {result.Skipped} skipped");
        foreach (var err in result.Errors.Take(5)) Ui.Error(err);
        await ReloadAsync();
    }
}
