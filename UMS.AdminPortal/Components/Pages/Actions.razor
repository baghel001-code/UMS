@page "/actions"
@inherits TenantPage

<PageTitle>User Action Trail · VMM UMS</PageTitle>

<PageHeader Title="User Action Trail" Subtitle="Every authorization decision made for end users across all applications: route, permission checked, decision and reason." />

<MudPaper Class="ums-card" Elevation="0">
    <MudToolBar Gutters="true" Class="gap-3 py-2" Style="height:auto;flex-wrap:wrap">
        <MudTextField @bind-Value="_search" Placeholder="Search user, permission, route…" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:260px" />
        <MudSelect T="string" @bind-Value="_app" Label="Application" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:200px">
            @foreach (var a in _logs.Select(l => l.App).Distinct().Order())
            {
                <MudSelectItem T="string" Value="a">@a</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="AccessDecisionResult?" @bind-Value="_decision" Label="Decision" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:160px">
            <MudSelectItem T="AccessDecisionResult?" Value="AccessDecisionResult.Allow">✓ Allow</MudSelectItem>
            <MudSelectItem T="AccessDecisionResult?" Value="AccessDecisionResult.Deny">✕ Deny</MudSelectItem>
        </MudSelect>
    </MudToolBar>
    <MudTable Items="Rows" Hover="true" Dense="true" Class="ums-table" Elevation="0" Loading="Loading" RowsPerPage="25">
        <HeaderContent><MudTh>Time</MudTh><MudTh>User</MudTh><MudTh>App</MudTh><MudTh>Route</MudTh><MudTh>Permission</MudTh><MudTh>Decision</MudTh><MudTh>Reason</MudTh><MudTh>IP</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd Style="white-space:nowrap">@Fmt.DateTime(context.Timestamp)</MudTd>
            <MudTd>@context.UserName</MudTd>
            <MudTd>@context.App</MudTd>
            <MudTd Class="mono">@context.Route</MudTd>
            <MudTd Class="mono">@context.Action</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Fmt.StatusColor(context.Decision.ToString())">@(context.Decision == AccessDecisionResult.Allow ? "✓ Allow" : "✕ Deny")</MudChip></MudTd>
            <MudTd Style="font-size:12.5px">@context.Reason</MudTd>
            <MudTd Class="muted">@context.Ip</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-6 muted">No actions recorded.</MudText></NoRecordsContent>
        <PagerContent><MudTablePager /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<UserActionLogDto> _logs = new();
    private string _search = "";
    private string? _app;
    private AccessDecisionResult? _decision;

    private IEnumerable<UserActionLogDto> Rows => _logs
        .Where(a => (_app is null || a.App == _app) && (_decision is null || a.Decision == _decision)
                    && $"{a.UserName} {a.Action} {a.Route} {a.Reason}".Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(a => a.Timestamp);

    protected override async Task LoadAsync() => _logs = await Api.UserActionsAsync(5000);
}
