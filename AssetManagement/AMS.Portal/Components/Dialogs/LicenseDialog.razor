<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="8"><MudTextField @bind-Value="Model.Name" Label="Software / licence name" Variant="Variant.Outlined" Required="true" /></MudItem>
            <MudItem xs="12" sm="4"><MudNumericField @bind-Value="Model.Seats" Label="Seats" Variant="Variant.Outlined" Min="1" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="Model.ProductKey" Label="Product key" Variant="Variant.Outlined" Class="mono" /></MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" @bind-Value="Model.ManufacturerId" Label="Manufacturer" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var m in Options.Manufacturers)
                    {
                        <MudSelectItem T="int?" Value="m.Id">@m.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" @bind-Value="Model.CategoryId" Label="Category" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var c in Options.Categories.Where(c => c.CategoryKind == CategoryKind.License))
                    {
                        <MudSelectItem T="int?" Value="c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" @bind-Value="Model.SupplierId" Label="Supplier" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var s in Options.Suppliers)
                    {
                        <MudSelectItem T="int?" Value="s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4"><MudDatePicker @bind-Date="Model.PurchaseDate" Label="Purchase date" Variant="Variant.Outlined" DateFormat="dd MMM yyyy" /></MudItem>
            <MudItem xs="12" sm="4"><MudNumericField @bind-Value="Model.PurchaseCost" Label="Cost (₹)" Variant="Variant.Outlined" Min="0" Format="N0" /></MudItem>
            <MudItem xs="12" sm="4"><MudDatePicker @bind-Date="Model.ExpirationDate" Label="Expires" Variant="Variant.Outlined" DateFormat="dd MMM yyyy" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="Model.Notes" Label="Notes" Variant="Variant.Outlined" Lines="2" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveAsync">@(IsNew ? "Create licence" : "Save changes")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public LicenseSaveReq Model { get; set; } = new();
    [Parameter] public OptionsRes Options { get; set; } = default!;
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public Func<LicenseSaveReq, Task<bool>> Submit { get; set; } = default!;
    private bool _busy;

    private async Task SaveAsync()
    {
        _busy = true;
        if (await Submit(Model)) MudDialog.Close(DialogResult.Ok(true));
        _busy = false;
    }
}
