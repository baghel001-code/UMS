@page "/activity"
@inject AppState State
@inject Ui Ui

<PageTitle>Activity log · VMM Assets</PageTitle>

<PageHeader Title="Activity log" Subtitle="Who did what in Asset Management. Every permission decision is also recorded in the UMS user action trail.">
    <Actions>
        @if (State.Can(Modules.Reports, Resources.Activity, Actions.Export))
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAsync">Export CSV</MudButton>
        }
    </Actions>
</PageHeader>

@if (_denied != null)
{
    <Denied What="the activity log" Reason="@_denied" />
}
else
{
    <MudPaper Class="ums-card" Elevation="0">
        <div class="ams-filters">
            <MudTextField T="string" Value="_search" ValueChanged="v => { _search = v; _ = LoadAsync(); }" Placeholder="Search item, person, note…" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" DebounceInterval="300" Class="grow" />
            <MudSelect T="ItemType?" Value="_type" ValueChanged="v => { _type = v; _ = LoadAsync(); }" Label="Item type" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var t in Enum.GetValues<ItemType>())
                {
                    <MudSelectItem T="ItemType?" Value="t">@t</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker Date="_from" DateChanged="d => { _from = d; _ = LoadAsync(); }" Label="From" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd MMM yyyy" Clearable="true" />
            <MudDatePicker Date="_to" DateChanged="d => { _to = d; _ = LoadAsync(); }" Label="To" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd MMM yyyy" Clearable="true" />
        </div>
        <MudTable T="HistoryEntry" Items="_rows" Loading="_loading" Hover="true" Dense="true" Elevation="0" Class="ums-table" RowsPerPage="50">
            <HeaderContent>
                <MudTh>When</MudTh>
                <MudTh>By</MudTh>
                <MudTh>Action</MudTh>
                <MudTh>Item</MudTh>
                <MudTh>Target</MudTh>
                <MudTh>Location</MudTh>
                <MudTh>Note</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="white-space:nowrap">@Fmt.DateTime(context.At)</MudTd>
                <MudTd>@context.ActorName<div class="muted" style="font-size:12px">@context.ActorEmpCode</div></MudTd>
                <MudTd Style="white-space:nowrap"><MudIcon Icon="@Fmt.Icon(context.Action)" Size="Size.Small" Color="Color.Primary" Class="mr-1" Style="vertical-align:-4px" />@Fmt.Action(context.Action)</MudTd>
                <MudTd><span class="muted">@context.ItemType ·</span> @context.ItemName</MudTd>
                <MudTd>@context.Target</MudTd>
                <MudTd>@context.LocationCode</MudTd>
                <MudTd class="muted">@context.Note</MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="muted pa-4">No activity matches.</MudText></NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="new[] { 50, 100, 200 }" /></PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    private List<HistoryEntry> _rows = new();
    private string? _search;
    private ItemType? _type;
    private DateTime? _from, _to;
    private bool _loading = true;
    private string? _denied;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _rows = (await Ui.Call<ActivityRes, ActivityReq>(AmsApiNames.GET_ACTIVITY, Filter, r => _denied = r))?.Entries ?? new();
        _loading = false;
        StateHasChanged();
    }

    private async Task ExportAsync()
    {
        if (await Ui.Call<FileRes, ActivityReq>(AmsApiNames.EXPORT_ACTIVITY, Filter) is { } file) await Ui.DownloadAsync(file);
    }

    private ActivityReq Filter => new() { ItemType = _type, Search = _search, From = _from, To = _to };
}
