@page "/setup/{Section}"
@inject AppState State
@inject Ui Ui

<PageTitle>@Title · VMM Assets</PageTitle>

<PageHeader Title="@Title" Subtitle="@Subtitle">
    <Actions>
        @if (State.Can(Modules.Setup, Setup(_kind), Actions.Create))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">Add</MudButton>
        }
    </Actions>
</PageHeader>

@if (_denied != null)
{
    <Denied What="@Title.ToLowerInvariant()" Reason="@_denied" />
}
else
{
    <MudPaper Class="ums-card" Elevation="0">
        <MudTable T="SetupItem" Items="_rows" Loading="_loading" Hover="true" Dense="true" Elevation="0" Class="ums-table" RowsPerPage="50" Filter="Matches">
            <ToolBarContent>
                <MudTextField @bind-Value="_search" Placeholder="Search…" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" Style="max-width:360px" />
            </ToolBarContent>
            <HeaderContent>
                @if (_kind == SetupKind.Location)
                {
                    <MudTh>Code</MudTh>
                }
                <MudTh>Name</MudTh>
                @switch (_kind)
                {
                    case SetupKind.Category: <MudTh>Used for</MudTh><MudTh>Depreciation</MudTh> break;
                    case SetupKind.Manufacturer: <MudTh>Website</MudTh><MudTh>Support</MudTh> break;
                    case SetupKind.Model: <MudTh>Model no.</MudTh><MudTh>Category</MudTh><MudTh>Manufacturer</MudTh><MudTh>EOL</MudTh> break;
                    case SetupKind.Supplier: <MudTh>Contact</MudTh><MudTh>Email</MudTh><MudTh>Phone</MudTh> break;
                    case SetupKind.Location: <MudTh>Region</MudTh> break;
                    case SetupKind.Status: <MudTh>Meaning</MudTh> break;
                }
                <MudTh Style="text-align:right">In use</MudTh>
                <MudTh Style="width:1%"></MudTh>
            </HeaderContent>
            <RowTemplate>
                @if (_kind == SetupKind.Location)
                {
                    <MudTd><span class="ams-tag">@context.Code</span></MudTd>
                }
                <MudTd><b>@context.Name</b></MudTd>
                @switch (_kind)
                {
                    case SetupKind.Category: <MudTd>@(context.CategoryKind)s</MudTd><MudTd>@(context.DepreciationMonths == 0 ? "—" : $"{context.DepreciationMonths} months")</MudTd> break;
                    case SetupKind.Manufacturer: <MudTd>@context.Url</MudTd><MudTd>@context.Email @context.Phone</MudTd> break;
                    case SetupKind.Model: <MudTd>@context.ModelNumber</MudTd><MudTd>@context.CategoryName</MudTd><MudTd>@context.ManufacturerName</MudTd><MudTd>@(context.EolMonths == 0 ? "—" : $"{context.EolMonths} m")</MudTd> break;
                    case SetupKind.Supplier: <MudTd>@context.ContactName</MudTd><MudTd>@context.Email</MudTd><MudTd>@context.Phone</MudTd> break;
                    case SetupKind.Location: <MudTd>@context.Region</MudTd> break;
                    case SetupKind.Status: <MudTd><span class="ams-dot @context.StatusType"></span>@context.StatusType</MudTd> break;
                }
                <MudTd Style="text-align:right">@context.UsedBy</MudTd>
                <MudTd>
                    <MudStack Row="true" Spacing="1">
                        @if (context.CanEdit)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAsync(context)" />
                        }
                        @if (context.CanDelete)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
                        }
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="muted pa-4">Nothing here yet.</MudText></NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="new[] { 50, 100 }" /></PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public string Section { get; set; } = "";
    private SetupKind _kind;
    private List<SetupItem> _rows = new();
    private string? _search;
    private bool _loading = true;
    private string? _denied;

    private static readonly Dictionary<string, (SetupKind Kind, string Title, string Subtitle)> Sections = new()
    {
        ["categories"] = (SetupKind.Category, "Categories", "Groups for assets, licences, accessories, consumables and components. The depreciation period drives book value."),
        ["manufacturers"] = (SetupKind.Manufacturer, "Manufacturers", "Brands and their support contacts."),
        ["models"] = (SetupKind.Model, "Asset models", "Every asset is an instance of a model (manufacturer + category)."),
        ["suppliers"] = (SetupKind.Supplier, "Suppliers", "Vendors that sell or service assets."),
        ["locations"] = (SetupKind.Location, "Locations", "Stores, DCs and offices. Codes match UMS user locations, so UMS role scopes (e.g. location=HO-GGN) apply to assets."),
        ["departments"] = (SetupKind.Department, "Departments", "Owning departments of assets."),
        ["statuses"] = (SetupKind.Status, "Status labels", "Asset states. Only Deployable statuses allow check-out."),
    };

    private string Title => Sections.TryGetValue(Section, out var s) ? s.Title : "Setup";
    private string Subtitle => Sections.TryGetValue(Section, out var s) ? s.Subtitle : "";

    protected override async Task OnParametersSetAsync()
    {
        if (!Sections.TryGetValue(Section, out var s)) return;
        _kind = s.Kind;
        _search = null;
        _denied = null;
        await LoadAsync();
    }

    private bool Matches(SetupItem i) => string.IsNullOrWhiteSpace(_search) ||
        $"{i.Code} {i.Name} {i.Region} {i.CategoryName} {i.ManufacturerName} {i.ContactName}".Contains(_search, StringComparison.OrdinalIgnoreCase);

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _rows = (await Ui.Call<SetupListRes, SetupListReq>(AmsApiNames.GET_SETUP, new SetupListReq { Kind = _kind }, r => _denied = r))?.Items ?? new();
        _loading = false;
        StateHasChanged();
    }

    private async Task EditAsync(SetupItem? item)
    {
        var options = await Ui.Get<OptionsRes>(AmsApiNames.GET_OPTIONS);
        if (options == null) return;
        var model = item?.Clone() ?? new SetupItem { Kind = _kind, Region = "North" };
        var p = new DialogParameters<LookupDialog>
        {
            { x => x.Model, model },
            { x => x.Options, options },
            { x => x.Submit, m => Ui.Do(AmsApiNames.SAVE_SETUP, m, "Saved") },
        };
        if (await Ui.DialogAsync<LookupDialog, bool>(item == null ? $"Add to {Title.ToLowerInvariant()}" : $"Edit {item.Name}", p)) await LoadAsync();
    }

    private async Task DeleteAsync(SetupItem item)
    {
        if (!await Ui.ConfirmAsync("Delete", $"Delete {item.Name}?", "Delete")) return;
        if (await Ui.Do(AmsApiNames.DELETE_SETUP, new SetupDeleteReq { Kind = _kind, Id = item.Id }, "Deleted")) await LoadAsync();
    }
}
