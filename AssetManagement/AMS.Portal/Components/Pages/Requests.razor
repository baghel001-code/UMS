@page "/requests"
@inject AppState State
@inject Ui Ui

<PageTitle>Asset requests · VMM Assets</PageTitle>

<PageHeader Title="Asset requests" Subtitle="Employees request available equipment; asset staff approve (which issues the asset) or reject. Who may see, cancel and approve each request is a UMS policy — for example nobody can approve their own request.">
    <Actions>
        @if (State.Can(Modules.Assets, Resources.Request, Actions.Request))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddShoppingCart" OnClick="NewRequestAsync">Request an asset</MudButton>
        }
    </Actions>
</PageHeader>

<MudPaper Class="ums-card" Elevation="0">
    <div class="ams-filters">
        <MudSelect T="RequestStatus?" Value="_status" ValueChanged="v => { _status = v; _ = LoadAsync(); }" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="RequestStatus?" Value="null">All</MudSelectItem>
            @foreach (var s in Enum.GetValues<RequestStatus>())
            {
                <MudSelectItem T="RequestStatus?" Value="s">@s</MudSelectItem>
            }
        </MudSelect>
    </div>
    <MudTable T="RequestRow" Items="_rows" Loading="_loading" Hover="true" Dense="true" Elevation="0" Class="ums-table" RowsPerPage="25">
        <HeaderContent>
            <MudTh>Requested</MudTh>
            <MudTh>By</MudTh>
            <MudTh>Asset</MudTh>
            <MudTh>Reason</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="width:1%"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="white-space:nowrap">@Fmt.DateTime(context.Request.RequestedAt)</MudTd>
            <MudTd>@context.Request.RequestedByName<div class="muted" style="font-size:12px">@context.Request.RequestedByEmpCode</div></MudTd>
            <MudTd><span class="ams-tag">@context.Request.AssetTag</span><div class="muted" style="font-size:12px">@context.Request.AssetName · @context.Request.LocationCode</div></MudTd>
            <MudTd Style="max-width:320px">@context.Request.Reason</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@Fmt.RequestColor(context.Request.Status)" Variant="Variant.Text">@context.Request.Status</MudChip>
                @if (context.Request.DecidedByName != null)
                {
                    <div class="muted" style="font-size:12px">by @context.Request.DecidedByName @(context.Request.DecisionNote == null ? "" : "· " + context.Request.DecisionNote)</div>
                }
            </MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    @if (context.CanApprove)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="() => DecideAsync(context, true)">Approve</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => DecideAsync(context, false)">Reject</MudButton>
                    }
                    @if (context.CanCancel)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => CancelAsync(context)">Cancel</MudButton>
                    }
                </MudStack>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="muted pa-4">No requests you are allowed to see.</MudText></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50 }" /></PagerContent>
    </MudTable>
</MudPaper>

<MudDialog @bind-Visible="_requesting" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>Request an asset</TitleContent>
    <DialogContent>
        @if (_available == null)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (_available.Count == 0)
        {
            <MudText Class="muted">No requestable assets are free right now.</MudText>
        }
        else
        {
            <MudStack Spacing="3">
                <MudSelect T="int?" @bind-Value="_assetId" Label="Asset" Variant="Variant.Outlined" Required="true">
                    @foreach (var a in _available)
                    {
                        <MudSelectItem T="int?" Value="a.Id">@a.AssetTag · @a.Name · @a.LocationCode</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_reason" Label="Why do you need it?" Variant="Variant.Outlined" Lines="3" Required="true" Immediate="true" />
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _requesting = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_assetId == null || string.IsNullOrWhiteSpace(_reason))" OnClick="SubmitRequestAsync">Submit request</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RequestRow> _rows = new();
    private RequestStatus? _status = RequestStatus.Pending;
    private bool _loading = true;
    private bool _requesting;
    private List<AssetView>? _available;
    private int? _assetId;
    private string? _reason;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _rows = (await Ui.Call<RequestListRes, RequestListReq>(AmsApiNames.GET_REQUESTS, new RequestListReq { Status = _status }))?.Rows ?? new();
        _loading = false;
        StateHasChanged();
    }

    private async Task NewRequestAsync()
    {
        _assetId = null;
        _reason = null;
        _available = null;
        _requesting = true;
        _available = (await Ui.Get<AssetsRes>(AmsApiNames.GET_REQUESTABLE))?.Assets ?? new();
    }

    private async Task SubmitRequestAsync()
    {
        if (await Ui.Do(AmsApiNames.CREATE_REQUEST, new RequestCreateReq { AssetId = _assetId!.Value, Reason = _reason! }, "Request submitted"))
        {
            _requesting = false;
            await LoadAsync();
        }
    }

    private async Task DecideAsync(RequestRow row, bool approve)
    {
        var r = row.Request;
        var p = new DialogParameters<NoteDialog>
        {
            { x => x.Message, approve ? $"Approve and issue {r.AssetTag} to {r.RequestedByName}?" : $"Reject {r.RequestedByName}'s request for {r.AssetTag}?" },
            { x => x.NoteLabel, approve ? "Note (optional)" : "Reason" },
            { x => x.NoteRequired, !approve },
            { x => x.Verb, approve ? "Approve & issue" : "Reject" },
            { x => x.Color, approve ? Color.Success : Color.Error },
            { x => x.Submit, n => Ui.Do(AmsApiNames.DECIDE_REQUEST, new RequestDecideReq { Id = r.Id, Approve = approve, Note = n.Note }, approve ? "Approved — asset issued" : "Rejected") },
        };
        if (await Ui.DialogAsync<NoteDialog, bool>(approve ? "Approve request" : "Reject request", p)) await LoadAsync();
    }

    private async Task CancelAsync(RequestRow row)
    {
        if (!await Ui.ConfirmAsync("Cancel request", $"Cancel the request for {row.Request.AssetTag}?", "Cancel request")) return;
        if (await Ui.Do(AmsApiNames.CANCEL_REQUEST, new IdReq { Id = row.Request.Id }, "Request cancelled")) await LoadAsync();
    }
}
