@page "/reports"
@inject AppState State
@inject Ui Ui

<PageTitle>Reports · VMM Assets</PageTitle>

<PageHeader Title="Reports" Subtitle="Asset value, depreciation and compliance. Each asset is included only if UMS allows you to report on it (e.g. a location-scoped manager sees their locations).">
    <Actions>
        @if (State.Can(Modules.Reports, Resources.Report, Actions.Export))
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAsync">Export depreciation CSV</MudButton>
        }
    </Actions>
</PageHeader>

@if (_denied != null)
{
    <Denied What="reports" Reason="@_denied" />
}
else if (_r == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid Spacing="3" Class="mb-2">
        <MudItem xs="12" sm="6" lg="3">@Stat("Assets", Fmt.Number(_r.Depreciation.Count), "in your reporting scope", Icons.Material.Filled.Devices)</MudItem>
        <MudItem xs="12" sm="6" lg="3">@Stat("Purchase value", Fmt.Compact(_r.TotalCost), "original cost", Icons.Material.Filled.CurrencyRupee)</MudItem>
        <MudItem xs="12" sm="6" lg="3">@Stat("Book value today", Fmt.Compact(_r.TotalValue), "straight-line by category life", Icons.Material.Filled.TrendingDown)</MudItem>
        <MudItem xs="12" sm="6" lg="3">@Stat("Depreciated", Fmt.Compact(_r.TotalCost - _r.TotalValue), $"{(_r.TotalCost == 0 ? 0 : (_r.TotalCost - _r.TotalValue) * 100 / _r.TotalCost):0}% of cost", Icons.Material.Filled.Percent)</MudItem>
    </MudGrid>

    <MudGrid Spacing="3" Class="my-1">
        <MudItem xs="12" md="4">@Breakdown("By category", _r.ByCategory)</MudItem>
        <MudItem xs="12" md="4">@Breakdown("By location", _r.ByLocation)</MudItem>
        <MudItem xs="12" md="4">@Breakdown("By status", _r.ByStatus)</MudItem>
    </MudGrid>

    <MudPaper Class="ums-card my-4" Elevation="0">
        <MudTabs Elevation="0" PanelClass="pa-0" ApplyEffectsToContainer="true">
            <MudTabPanel Text="@($"Depreciation ({_r.Depreciation.Count})")">
                <MudTable T="DepreciationRow" Items="_r.Depreciation" Dense="true" Hover="true" Elevation="0" Class="ums-table" RowsPerPage="15">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel T="DepreciationRow" SortBy="d => d.Asset.AssetTag">Asset</MudTableSortLabel></MudTh>
                        <MudTh>Category</MudTh>
                        <MudTh>Purchased</MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel T="DepreciationRow" SortBy="d => d.Asset.PurchaseCost">Cost</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right">Age (months)</MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel T="DepreciationRow" SortBy="d => d.CurrentValue">Book value</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><MudLink Href="@($"assets/{context.Asset.Id}")" Class="ams-tag">@context.Asset.AssetTag</MudLink> @context.Asset.Name</MudTd>
                        <MudTd>@context.Asset.CategoryName <span class="muted">(@context.Asset.DepreciationMonths m)</span></MudTd>
                        <MudTd>@Fmt.Date(context.Asset.PurchaseDate)</MudTd>
                        <MudTd Style="text-align:right">@Fmt.Money(context.Asset.PurchaseCost)</MudTd>
                        <MudTd Style="text-align:right">@context.Months</MudTd>
                        <MudTd Style="text-align:right"><b>@Fmt.Money(context.CurrentValue)</b></MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager PageSizeOptions="new[] { 15, 50, 100 }" /></PagerContent>
                </MudTable>
            </MudTabPanel>
            <MudTabPanel Text="@($"Warranty ending ({_r.WarrantyExpiring.Count})")">@AssetList(_r.WarrantyExpiring, a => $"warranty ends {Fmt.Date(a.WarrantyExpires)}")</MudTabPanel>
            <MudTabPanel Text="@($"Audits due ({_r.AuditDue.Count})")">@AssetList(_r.AuditDue, a => $"audit due {Fmt.Date(a.NextAuditDate)}")</MudTabPanel>
            <MudTabPanel Text="@($"Overdue check-ins ({_r.OverdueCheckins.Count})")">@AssetList(_r.OverdueCheckins, a => $"{a.AssignedToName} · was due {Fmt.Date(a.ExpectedCheckin)}")</MudTabPanel>
        </MudTabs>
    </MudPaper>
}

@code {
    private AssetReportRes? _r;
    private string? _denied;

    protected override async Task OnInitializedAsync() => _r = await Ui.Get<AssetReportRes>(AmsApiNames.GET_ASSET_REPORT, r => _denied = r);

    private async Task ExportAsync()
    {
        if (await Ui.Get<FileRes>(AmsApiNames.EXPORT_ASSET_REPORT) is { } file) await Ui.DownloadAsync(file);
    }

    private static RenderFragment Stat(string label, string value, string sub, string icon) => __builder =>
    {
        <MudPaper Class="ums-card ums-stat" Elevation="0">
            <div class="ums-stat-ico"><MudIcon Icon="@icon" /></div>
            <div><div class="label">@label</div><div class="value">@value</div><div class="sub">@sub</div></div>
        </MudPaper>
    };

    private static RenderFragment Breakdown(string title, List<CountRow> rows) => __builder =>
    {
        var max = Math.Max(1m, rows.Count == 0 ? 1m : rows.Max(r => r.Value));
        <MudPaper Class="ums-card" Elevation="0" Style="height:100%">
            <div class="ums-card-head"><MudText Typo="Typo.h6">@title</MudText><span class="muted" style="font-size:12px">count · value</span></div>
            <div class="ums-card-body">
                @foreach (var r in rows.Take(10))
                {
                    <div class="ums-hbar" style="grid-template-columns:minmax(90px,130px) 1fr 110px">
                        <span title="@r.Label">@r.Label</span>
                        <div class="ums-track"><div class="ums-seg blue" style="width:@(((double)(r.Value * 100 / max)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                        <b>@r.Count · @Fmt.Compact(r.Value)</b>
                    </div>
                }
            </div>
        </MudPaper>
    };

    private static RenderFragment AssetList(List<AssetView> assets, Func<AssetView, string> detail) => __builder =>
    {
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="ums-table">
            <tbody>
                @foreach (var a in assets)
                {
                    <tr>
                        <td><MudLink Href="@($"assets/{a.Id}")" Class="ams-tag">@a.AssetTag</MudLink></td>
                        <td>@a.Name</td>
                        <td>@a.LocationCode</td>
                        <td class="muted">@detail(a)</td>
                    </tr>
                }
                @if (assets.Count == 0)
                {
                    <tr><td class="muted pa-4">Nothing here ✓</td></tr>
                }
            </tbody>
        </MudSimpleTable>
    };
}
