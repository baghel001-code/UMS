<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>VMM Asset Management</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="@Assets["css/app.css"]" rel="stylesheet" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" ClientIp="@_ip" UserAgent="@_userAgent" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["js/app.js"]"></script>
</body>

</html>

@code {
    // interactive without prerendering: pages load their data from the AMS API once the circuit (and the user's tokens) are available
    private static readonly IComponentRenderMode PageRenderMode = new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private string? _ip, _userAgent;

    // the browser's address is only known on this first request; it goes to UMS with sign-in and every check (env.ip / env.network)
    protected override void OnInitialized()
    {
        var ip = HttpContext?.Connection.RemoteIpAddress;
        _ip = (ip is { IsIPv4MappedToIPv6: true } ? ip.MapToIPv4() : ip)?.ToString();
        _userAgent = HttpContext?.Request.Headers.UserAgent.ToString();
    }
}
