@* Signs the user out after the tenant's idle timeout (from UMS security settings, carried in the sign-in), with a one-minute warning.
   While the user is active, idle-timeout.js calls the keep-alive endpoint, which renews the cookie and tells UMS the session is in use;
   if UMS says the session ended (signed in on another device, revoked), the user is signed out with that reason. Place once in MainLayout. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject UserActivityState Activity

<LogoutForm @ref="_logout" />

@if (_secondsLeft is { } left)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="10000">
        <MudPaper Class="ums-login-card pa-6" Elevation="8" Style="max-width:420px">
            <MudText Typo="Typo.h6" Class="mb-2">Session about to expire</MudText>
            <MudText Class="mb-4">You have been inactive for a while. For your security you will be signed out in <b>@left</b> seconds.</MudText>
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Text" OnClick="() => Logout(idle: false)">Sign out</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ReportActivity">Stay signed in</MudButton>
            </MudStack>
        </MudPaper>
    </MudOverlay>
}

@code {
    private static readonly TimeSpan Warning = TimeSpan.FromSeconds(60);
    private static readonly TimeSpan ReportThrottle = TimeSpan.FromSeconds(10);

    private readonly CancellationTokenSource _cts = new();
    private LogoutForm? _logout;
    private TimeSpan _timeout = TimeSpan.FromMinutes(30);
    private int? _secondsLeft;
    private bool _ending;
    private DotNetObjectReference<IdleTimeoutMonitor>? _self;
    private IJSObjectReference? _module, _tracker;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var user = PortalUser.From((await Auth.GetAuthenticationStateAsync()).User);
        if (user == null) return;
        _timeout = TimeSpan.FromMinutes(Math.Max(1, user.IdleMinutes));
        Activity.Touch();
        _ = RunAsync();
        try
        {
            // keep-alive well under half the cookie / UMS idle window so an active user is never signed out
            var keepAlive = TimeSpan.FromTicks(Math.Clamp(_timeout.Ticks / 4, TimeSpan.FromSeconds(30).Ticks, TimeSpan.FromMinutes(5).Ticks));
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", Nav.ToAbsoluteUri("js/idle-timeout.js").ToString());
            _tracker = await _module.InvokeAsync<IJSObjectReference>("start", _self, new
            {
                reportThrottleMs = (int)ReportThrottle.TotalMilliseconds,
                keepAliveUrl = Nav.ToAbsoluteUri(AuthConstants.KeepAliveEndpoint.TrimStart('/')).ToString(),
                keepAliveIntervalMs = (int)keepAlive.TotalMilliseconds
            });
        }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public void ReportActivity()
    {
        if (_ending) return;
        Activity.Touch();
        if (_secondsLeft != null)
        {
            _secondsLeft = null;
            StateHasChanged();
        }
    }

    /// <summary>The keep-alive learned from UMS that the session ended elsewhere.</summary>
    [JSInvokable]
    public void SessionEnded(string reason) => _ = InvokeAsync(() => Leave(reason));

    private async Task RunAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
                await InvokeAsync(Tick);
        }
        catch (OperationCanceledException) { }
    }

    private void Tick()
    {
        if (_ending) return;
        var remaining = _timeout - Activity.IdleFor;
        if (remaining <= TimeSpan.Zero)
        {
            Logout(idle: true);
            return;
        }
        int? left = remaining <= Warning ? (int)Math.Ceiling(remaining.TotalSeconds) : null;
        if (left != _secondsLeft)
        {
            _secondsLeft = left;
            StateHasChanged();
        }
    }

    private void Logout(bool idle) => Leave(idle ? "idle" : "signedout");

    private void Leave(string reason)
    {
        if (_ending) return;
        _ending = true;
        _secondsLeft = null;
        StateHasChanged();
        // a real HTTP POST to /account/sign-out clears the cookie (and ends the UMS session for idle / sign out)
        _ = _logout?.SubmitAsync(reason);
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        try
        {
            if (_tracker != null)
            {
                await _tracker.InvokeVoidAsync("dispose");
                await _tracker.DisposeAsync();
            }
            if (_module != null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
        _cts.Dispose();
    }
}
