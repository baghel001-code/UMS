@page "/assets/labels"
@inject AssetService AssetSvc
@inject Ui Ui
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageTitle>Asset labels · VMM Assets</PageTitle>

<div class="no-print">
    <PageHeader Title="Asset labels" Subtitle="Tag labels (asset tag, name, location) for the assets you may print (UMS permission AMS.ASSETS.ASSET.PRINT). Use the browser's print dialog; labels never split across pages.">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Href="assets">Back to assets</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" Disabled="@(_assets is not { Count: > 0 })"
                       OnClick="@(() => Js.InvokeVoidAsync("ams.print").AsTask())">Print</MudButton>
        </Actions>
    </PageHeader>
</div>

@if (_denied != null)
{
    <Denied What="label printing" Reason="@_denied" />
}
else if (_assets == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <div class="ams-labels">
        @foreach (var a in _assets)
        {
            <div class="ams-label">
                <div class="ums-logo">V</div>
                <div>
                    <b>@a.AssetTag</b>
                    <small>@a.Name</small>
                    <small>@a.Location?.Code · Property of Vishal Mega Mart</small>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Asset>? _assets;
    private string? _denied;

    protected override async Task OnInitializedAsync()
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        var filter = new AssetFilter { LocationId = q.TryGetValue("location", out var l) && Guid.TryParse(l, out var id) ? id : null };
        _assets = await Ui.Run(() => AssetSvc.LabelsAsync(filter), r => _denied = r) ?? (_denied == null ? new() : null);
    }
}
