@page "/"
@inject ReportService Reports
@inject AMS.Infrastructure.Ums.UmsSession Session
@inject AppState State
@inject Ui Ui
@inject NavigationManager Nav

<PageTitle>Dashboard · VMM Assets</PageTitle>

@if (_denied != null)
{
    <Denied What="the asset dashboard" Reason="@_denied" />
}
else if (_d == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <section class="ums-hero">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
            <div>
                <h1>@Greeting(), @(Session.Actor?.Name.Split(' ')[0])</h1>
                <p>Asset Management · @DateTime.Now.ToString("dddd, d MMMM yyyy") · figures cover the assets UMS lets you see</p>
            </div>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <span class="ums-hero-badge">@Fmt.Number(_d.Assets) assets</span>
                <span class="ums-hero-badge">@Fmt.Compact(_d.TotalCost) purchase value</span>
            </MudStack>
        </MudStack>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-5">
            @if (State.Can(Modules.Assets, Resources.Asset, Actions.Create))
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AddBox" Href="assets?new=1">Add asset</MudButton>
            }
            @if (State.Can(Modules.Assets, Resources.Asset, Actions.Checkout))
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Logout" Href="assets?status=instock">Check out an asset</MudButton>
            }
            @if (_d.ShowRequests)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AssignmentInd" Href="requests">Review requests</MudButton>
            }
            @if (State.Can(Modules.Reports, Resources.Report, Actions.View))
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Assessment" Href="reports">Reports</MudButton>
            }
        </MudStack>
    </section>

    <MudGrid Spacing="3" Class="mb-2">
        @foreach (var k in Kpis())
        {
            <MudItem xs="12" sm="6" lg="3">
                <MudPaper Class="ums-card" Elevation="0">
                    <a class="ums-card ums-stat" href="@k.Href">
                        <div class="ums-stat-ico"><MudIcon Icon="@k.Icon" /></div>
                        <div>
                            <div class="label">@k.Label</div>
                            <div class="value">@k.Value</div>
                            <div class="sub">@k.Sub</div>
                        </div>
                    </a>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudGrid Spacing="3" Class="my-1">
        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="ums-card" Elevation="0" Style="height:100%">
                <div class="ums-card-head"><MudText Typo="Typo.h6">Assets by category</MudText></div>
                <div class="ums-card-body">@Bars(_d.ByCategory, "blue")</div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="ums-card" Elevation="0" Style="height:100%">
                <div class="ums-card-head"><MudText Typo="Typo.h6">Assets by location</MudText></div>
                <div class="ums-card-body">@Bars(_d.ByLocation, "blue")</div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="12" lg="4">
            <MudPaper Class="ums-card" Elevation="0" Style="height:100%">
                <div class="ums-card-head"><MudText Typo="Typo.h6">Deployment status</MudText></div>
                <div class="ums-card-body">
                    @{
                        var total = Math.Max(1, _d.Assets);
                        var inStock = _d.ReadyToDeploy;
                        var other = _d.Assets - _d.CheckedOut - inStock - _d.NotDeployable;
                    }
                    <div class="ums-split">
                        <div class="ums-seg blue" style="width:@Pct(_d.CheckedOut, total)"></div>
                        <div class="ums-seg ok" style="width:@Pct(inStock, total)"></div>
                        <div class="ums-seg warn" style="width:@Pct(_d.NotDeployable, total)"></div>
                        <div class="ums-seg" style="width:@Pct(other, total);background:#9fb0cf"></div>
                    </div>
                    <div class="ums-legend">
                        <span><i style="background:var(--blue-500)"></i>Checked out @_d.CheckedOut</span>
                        <span><i style="background:var(--ok-mark)"></i>Ready @inStock</span>
                        <span><i style="background:var(--warn-mark)"></i>Repair / broken @_d.NotDeployable</span>
                        <span><i style="background:#9fb0cf"></i>Other @other</span>
                    </div>
                    <MudDivider Class="my-4" />
                    @Bars(_d.ByStatus, "blue")
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3" Class="my-1">
        <MudItem xs="12" md="4">
            @Watchlist("Audits due (30 days)", _d.AuditDue, a => $"due {Fmt.Date(a.NextAuditDate)}", Icons.Material.Filled.FactCheck)
        </MudItem>
        <MudItem xs="12" md="4">
            @Watchlist("Overdue check-ins", _d.OverdueCheckins, a => $"{a.AssignedToName} · due {Fmt.Date(a.ExpectedCheckin)}", Icons.Material.Filled.AlarmOn)
        </MudItem>
        <MudItem xs="12" md="4">
            @Watchlist("Warranty ending (90 days)", _d.WarrantyExpiring, a => $"ends {Fmt.Date(a.WarrantyExpires)}", Icons.Material.Filled.VerifiedUser)
        </MudItem>
    </MudGrid>

    @if (_d.ShowActivity)
    {
        <MudPaper Class="ums-card my-4" Elevation="0">
            <div class="ums-card-head">
                <MudText Typo="Typo.h6">Recent activity</MudText>
                <MudLink Href="activity" Typo="Typo.caption">Activity log →</MudLink>
            </div>
            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="ums-table">
                <tbody>
                    @foreach (var h in _d.Recent)
                    {
                        <tr>
                            <td style="width:36px"><MudIcon Icon="@Fmt.Icon(h.Action)" Size="Size.Small" Color="Color.Primary" /></td>
                            <td><b>@Fmt.Action(h.Action)</b> · @h.ItemName <span class="muted">@(h.Target == null ? "" : "→ " + h.Target)</span></td>
                            <td class="muted">@h.ActorName</td>
                            <td class="muted" style="white-space:nowrap">@Fmt.DateTime(h.At)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}

@code {
    private Dashboard? _d;
    private string? _denied;

    private record Kpi(string Label, string Value, string Sub, string Icon, string Href);

    protected override async Task OnInitializedAsync()
    {
        if (!State.Can(Modules.Dashboard, Resources.Overview, Actions.View))
        {
            // no dashboard in UMS for this user: open the first page they do have
            var first = NavMenu.Groups.SelectMany(g => g.Items).FirstOrDefault(i => i.Href != "" && State.Can(i.Module, i.Resource, i.Action));
            if (first != null)
            {
                Nav.NavigateTo(first.Href, replace: true);
                return;
            }
        }
        _d = await Ui.Run(() => Reports.DashboardAsync(), r => _denied = r);
    }

    private IEnumerable<Kpi> Kpis()
    {
        yield return new("Assets", Fmt.Number(_d!.Assets), $"{_d.ReadyToDeploy} ready to deploy", Icons.Material.Filled.Devices, "assets");
        yield return new("Checked out", Fmt.Number(_d.CheckedOut), $"{(_d.Assets == 0 ? 0 : _d.CheckedOut * 100 / _d.Assets)}% utilisation", Icons.Material.Filled.Logout, "assets?status=out");
        if (_d.ShowLicenses)
            yield return new("Licence seats", $"{_d.LicenseSeatsUsed}/{_d.LicenseSeats}", $"{_d.LicenseSeats - _d.LicenseSeatsUsed} free", Icons.Material.Filled.VpnKey, "licenses");
        if (_d.ShowRequests)
            yield return new("Requests to review", Fmt.Number(_d.PendingRequests), "pending your decision", Icons.Material.Filled.AssignmentInd, "requests");
        if (_d.ShowStock)
            yield return new("Low stock", Fmt.Number(_d.LowStock), "accessories & consumables at minimum", Icons.Material.Filled.Inventory2, "consumables");
        yield return new("In repair / broken", Fmt.Number(_d.NotDeployable), $"{_d.MaintenanceOpen} open maintenance jobs", Icons.Material.Filled.Build, "maintenance");
    }

    private static string Pct(int part, int total) => $"{Math.Max(0, part) * 100.0 / total:0.##}%".Replace(',', '.');

    private static RenderFragment Bars(List<CountRow> rows, string css) => __builder =>
    {
        var max = Math.Max(1, rows.Count == 0 ? 1 : rows.Max(r => r.Count));
        if (rows.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted">No assets.</MudText>
        }
        foreach (var r in rows.Take(8))
        {
            <div class="ums-hbar">
                <span title="@r.Label">@r.Label</span>
                <div class="ums-track"><div class="ums-seg @css" style="width:@Pct(r.Count, max)"></div></div>
                <b>@r.Count</b>
            </div>
        }
    };

    private RenderFragment Watchlist(string title, List<Asset> items, Func<Asset, string> sub, string icon) => __builder =>
    {
        <MudPaper Class="ums-card" Elevation="0" Style="height:100%">
            <div class="ums-card-head">
                <MudText Typo="Typo.h6">@title</MudText>
                <MudChip T="string" Size="Size.Small" Color="@(items.Count > 0 ? Color.Warning : Color.Success)" Variant="Variant.Text">@items.Count</MudChip>
            </div>
            <div class="ums-card-body">
                @if (items.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="muted">Nothing here ✓</MudText>
                }
                @foreach (var a in items)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                        <MudIcon Icon="@icon" Size="Size.Small" Color="Color.Primary" />
                        <div>
                            <MudLink Href="@($"assets/{a.Id}")" Class="ams-tag">@a.AssetTag</MudLink> <span>@a.Name</span>
                            <div class="muted" style="font-size:12px">@sub(a) · @a.Location?.Code</div>
                        </div>
                    </MudStack>
                }
            </div>
        </MudPaper>
    };

    private static string Greeting() => DateTime.Now.Hour switch
    {
        var h when h >= 17 => "Good evening",
        var h when h >= 12 => "Good afternoon",
        _ => "Good morning"
    };
}
