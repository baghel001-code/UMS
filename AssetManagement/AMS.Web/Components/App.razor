<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>VMM Asset Management</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="@Assets["css/app.css"]" rel="stylesheet" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" ClientIp="@_clientIp" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["js/app.js"]"></script>
</body>

</html>

@code {
    // no prerendering: the UMS token lives in browser session storage, which is only readable once interactive
    private static readonly IComponentRenderMode PageRenderMode = new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // the browser's address is only known on this first request; UMS policies use it (env.ip / env.network)
    private string _clientIp = "";

    protected override void OnInitialized() => _clientIp = HttpContext?.Connection.RemoteIpAddress?.ToString() ?? "";
}
