<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            @if (Model.Kind == LookupKind.Location)
            {
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="Model.Code" Label="Code" Variant="Variant.Outlined" Required="true" HelperText="Same code as in UMS user profiles" /></MudItem>
                <MudItem xs="12" sm="8"><MudTextField @bind-Value="Model.Name" Label="Name" Variant="Variant.Outlined" Required="true" /></MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="Model.Region" Label="Region" Variant="Variant.Outlined">
                        @foreach (var r in new[] { "North", "East", "West", "South", "Central" })
                        {
                            <MudSelectItem T="string" Value="r">@r</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="8"><MudTextField @bind-Value="Model.Address" Label="Address" Variant="Variant.Outlined" /></MudItem>
            }
            else
            {
                <MudItem xs="12"><MudTextField @bind-Value="Model.Name" Label="Name" Variant="Variant.Outlined" Required="true" /></MudItem>
            }
            @switch (Model.Kind)
            {
                case LookupKind.Category:
                    <MudItem xs="12" sm="6">
                        <MudSelect T="CategoryKind" @bind-Value="Model.CategoryKind" Label="Used for" Variant="Variant.Outlined">
                            @foreach (var k in Enum.GetValues<CategoryKind>())
                            {
                                <MudSelectItem T="CategoryKind" Value="k">@(k)s</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6"><MudNumericField @bind-Value="Model.DepreciationMonths" Label="Depreciation (months, 0 = none)" Variant="Variant.Outlined" Min="0" /></MudItem>
                    break;
                case LookupKind.Manufacturer:
                    <MudItem xs="12"><MudTextField @bind-Value="Model.Url" Label="Website" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="Model.Email" Label="Support email" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="Model.Phone" Label="Support phone" Variant="Variant.Outlined" /></MudItem>
                    break;
                case LookupKind.Supplier:
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="Model.ContactName" Label="Contact person" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="Model.Email" Label="Email" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="Model.Phone" Label="Phone" Variant="Variant.Outlined" /></MudItem>
                    break;
                case LookupKind.Model:
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="Model.ModelNumber" Label="Model number" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" sm="6"><MudNumericField @bind-Value="Model.EolMonths" Label="End of life (months)" Variant="Variant.Outlined" Min="0" /></MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid?" @bind-Value="Model.CategoryId" Label="Category" Variant="Variant.Outlined" Required="true">
                            @foreach (var c in Options.Categories.Where(c => c.Kind == CategoryKind.Asset))
                            {
                                <MudSelectItem T="Guid?" Value="c.Id">@c.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid?" @bind-Value="Model.ManufacturerId" Label="Manufacturer" Variant="Variant.Outlined" Required="true">
                            @foreach (var m in Options.Manufacturers)
                            {
                                <MudSelectItem T="Guid?" Value="m.Id">@m.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    break;
                case LookupKind.Status:
                    <MudItem xs="12">
                        <MudSelect T="StatusType" @bind-Value="Model.StatusType" Label="Meaning" Variant="Variant.Outlined"
                                   HelperText="Only Deployable statuses allow check-out">
                            @foreach (var t in Enum.GetValues<StatusType>())
                            {
                                <MudSelectItem T="StatusType" Value="t">@t</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    break;
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public LookupItem Model { get; set; } = new();
    [Parameter] public Options Options { get; set; } = default!;
    [Parameter] public Func<LookupItem, Task<bool>> Submit { get; set; } = default!;
    private bool _busy;

    private async Task SaveAsync()
    {
        _busy = true;
        if (await Submit(Model)) MudDialog.Close(DialogResult.Ok(true));
        _busy = false;
    }
}
